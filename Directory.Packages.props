<!-- declare all packages that may be used by projects here; versions will be shared -->

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>

    <!-- system -->

    <PackageVersion Include="DotNetConfig" Version="1.2.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.5" />
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.3.6" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.49-beta" /> <!-- need this older version for netstandard, i haven't figured out the issue yet -->
    <PackageVersion Include="OkTools.Core" Version="1.1.2" />
    <PackageVersion Include="OkTools.NiceIO" Version="1.0.10" />
    <PackageVersion Include="PInvoke.Kernel32" Version="0.7.124" />
    <PackageVersion Include="PInvoke.NTDll" Version="0.7.124" />
    <PackageVersion Include="Spectre.Console" Version="0.50.0" />
    <PackageVersion Include="Spreads.LMDB" Version="2023.930.421" />
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.5" />
    <PackageVersion Include="System.Interactive" Version="6.0.1" />
    <PackageVersion Include="TextCopy" Version="6.2.1" />
    <PackageVersion Include="Vanara.Pinvoke.Dbghelp" Version="4.0.4" />
    <PackageVersion Include="Vezel.Cathode" Version="0.14.17" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="docopt.net" Version="0.8.1" />

    <!-- analysis -->

    <PackageVersion Include="JetBrains.Annotations" Version="2024.3.0" />

    <!-- builds -->

    <PackageVersion Include="T4.Build" Version="0.2.4" />

    <!-- testing and debugging -->

    <PackageVersion Include="benchmarkdotnet" Version="0.15.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Dumpify" Version="0.6.6" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />

  </ItemGroup>
</Project>