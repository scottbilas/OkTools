<!-- declare all packages that may be used by projects here; versions will be shared -->

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>

    <!-- system -->

    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.49-beta" />
    <PackageVersion Include="docopt.net" Version="0.8.1" />
    <PackageVersion Include="DotNetConfig" Version="1.0.6" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="8.0.0" />
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.3.6" />
    <PackageVersion Include="OkTools.NiceIO" Version="1.0.6" />
    <PackageVersion Include="PInvoke.Kernel32" Version="0.7.124" />
    <PackageVersion Include="PInvoke.NTDll" Version="0.7.124" />
    <PackageVersion Include="Spectre.Console" Version="0.49.1" />
    <PackageVersion Include="Spreads.LMDB" Version="2023.930.421" />
    <PackageVersion Include="System.Interactive" Version="6.0.1" />
    <PackageVersion Include="System.IO.Pipelines" Version="8.0.0" />
    <PackageVersion Include="TextCopy" Version="6.2.1" />
    <PackageVersion Include="Vanara.Pinvoke.Dbghelp" Version="4.0.0" />
    <PackageVersion Include="Vezel.Cathode" Version="0.14.17" />
    <PackageVersion Include="YamlDotNet" Version="15.1.2" />

    <!-- analysis -->

    <PackageVersion Include="JetBrains.Annotations" Version="2024.2.0" />

    <!-- builds -->

    <PackageVersion Include="T4.Build" Version="0.2.4" />

    <!-- testing and debugging -->

    <PackageVersion Include="benchmarkdotnet" Version="0.13.12" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Dumpify" Version="0.6.6" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageVersion Include="NUnit" Version="4.1.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />

  </ItemGroup>
</Project>